# Variabel khusus untuk docker-compose.yml (root) — bukan .env milik Laravel.
# Copy ke `.env` di root, isi nilainya, lalu `docker compose up`.

# Password root MariaDB (dipakai container mysql + koneksi DB backend/frontend-v2).
MYSQL_ROOT_PASSWORD=root

# Ambil dari https://dashboard.ngrok.com/get-started/your-authtoken (akun ngrok gratis cukup).
#
# Free plan cuma dapat SATU ephemeral domain per sesi — jadi hanya satu tunnel aktif
# pada satu waktu, frontend ATAU backend, tidak bisa dua-duanya bersamaan.
#   default    : backend:8080   (webhook Midtrans)
#   alternatif : frontend:8000  (buka aplikasi dari HP)
# Cara menukar target: lihat README §Tunneling (ngrok).
NGROK_AUTHTOKEN=
