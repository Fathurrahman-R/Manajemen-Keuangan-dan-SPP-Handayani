APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL aplikasi frontend-v2. Dipakai untuk link reset password dan redirect setelah
# pembayaran Midtrans selesai. WAJIB diganti ke domain asli saat deploy — kalau
# tidak, link di email dan redirect pembayaran menunjuk ke localhost penerima.
FRONTEND_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS butuh ekstensi pcntl (process fork) — TIDAK tersedia di PHP Windows
# ("forking is not supported on this platform"). Hanya relevan di Linux/WSL/Docker, dan hanya
# efektif dengan flag `php artisan serve --no-reload` (reload-watcher default menonaktifkannya).
# Production (nginx+php-fpm) sudah konkuren native, tidak butuh ini sama sekali.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=backend
DB_USERNAME=root
DB_PASSWORD=

# Masa berlaku token Sanctum dalam menit (default 480 = 8 jam). Setelah lewat,
# request dari frontend-v2 ditolak 401 dan user harus login ulang.
SANCTUM_TOKEN_EXPIRATION=480

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis dipakai (bukan phpredis) — pure PHP, tidak butuh ekstensi C, dan sudah jadi
# composer dependency (predis/predis). phpredis butuh ekstensi PECL yang tidak
# di-install di manapun di repo ini.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Payment Gateway
#
# Pakai akun Midtrans Sandbox MILIK SENDIRI — gratis, daftar sendiri, tidak perlu
# minta kredensial ke siapa pun. Cara ambil ketiga nilai di bawah: docs/midtrans.md
# Kunci sandbox selalu berawalan `SB-` (mis. `SB-Mid-server-xxxxx`);
# kalau tidak ada awalan itu, berarti kunci production — jangan dipakai untuk dev.
#
# MIDTRANS_SERVER_KEY itu RAHASIA (bisa dipakai untuk charge/refund atas nama
# merchant). Jangan pernah di-commit, jangan dikirim lewat chat.
HANDAYANI_MIDTRANS_ENABLED=true
HANDAYANI_MIDTRANS_WEBHOOK_ENABLED=true
MIDTRANS_ENVIRONMENT=sandbox
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_MERCHANT_ID=Gxxxxxxxxx
HANDAYANI_MIDTRANS_FEE_FLAT=4000

# Kedaluwarsa transaksi sejak diinisiasi, dalam menit (default 1440 = 24 jam).
# Turunkan hanya untuk keperluan uji coba expired, dan jangan lupa kembalikan.
#MIDTRANS_EXPIRY_MINUTES=1440

# URL yang dibuka setelah siswa selesai/batal di halaman Snap.
# Default mengikuti FRONTEND_URL + /portal/beranda, isi hanya kalau perlu beda.
#MIDTRANS_FINISH_URL=
