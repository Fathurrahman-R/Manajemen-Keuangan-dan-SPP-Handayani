// =============================================================
// ERD - Modul Approval dan Notifikasi
// Sistem Informasi Pembayaran SPP Yayasan Handayani
//
// Format     : DBML (dbdiagram.io)
// Cara pakai : buka https://dbdiagram.io/d lalu paste seluruh isi file ini.
//
// Catatan penyusunan:
// - Kolom created_at / updated_at tidak ditampilkan agar diagram tetap
//   terbaca, mengikuti konvensi versi ERD mermaid.
// - Tipe data dan constraint diverifikasi terhadap file migrasi di
//   backend/database/migrations.
// =============================================================

Table branches {
  id bigint [pk, increment]
  location varchar(255) [not null]

  Note: 'Cabang atau unit yayasan. Menjadi dasar pemisahan data antar unit.'
}

Table users {
  id bigint [pk, increment]
  username varchar(100) [not null, unique]
  email varchar(255) [null, note: 'Unik per branch, bukan unik global']
  email_verified_at timestamp [null]
  name varchar(255) [null]
  password varchar(100) [not null]
  branch_id bigint [not null]
  siswa_id bigint [null, note: 'FK ke siswas.id - lihat ERD Data Master']
  is_active boolean [not null, default: true]
  must_change_password boolean [not null, default: false]

  indexes {
    (email, branch_id) [unique, name: 'users_email_branch_unique']
  }

  Note: 'Akun pengguna sistem. Berperan sebagai pengaju maupun penyetuju pengeluaran.'
}

Table pengeluaran_requests {
  id bigint [pk, increment]
  uraian varchar(255) [not null]
  jumlah decimal(13,2) [not null]
  tanggal_kebutuhan date [not null]
  kategori_pengeluaran varchar(255) [null]
  lampiran varchar(255) [null]
  status enum [not null, default: 'draft', note: 'draft, submitted, approved, rejected, disbursed']
  requester_id bigint [not null]
  branch_id bigint [not null]

  indexes {
    (branch_id, status)
    (requester_id)
  }

  Note: 'Pengajuan pengeluaran yang harus melewati alur persetujuan.'
}

Table approval_logs {
  id bigint [pk, increment]
  pengeluaran_request_id bigint [not null]
  previous_status varchar(255) [not null]
  new_status varchar(255) [not null]
  user_id bigint [not null, note: 'Pengguna yang melakukan perubahan status']
  note text [null]
  created_at timestamp [not null, note: 'Tabel ini hanya punya created_at, tanpa updated_at']

  indexes {
    (pengeluaran_request_id, created_at) [name: 'approval_logs_request_created_index']
  }

  Note: 'Jejak audit perubahan status pengajuan. Hanya menyimpan created_at.'
}

Table branch_approval_settings {
  id bigint [pk, increment]
  branch_id bigint [not null, unique]
  auto_approval_enabled boolean [not null, default: false]
  auto_approval_threshold decimal(13,2) [not null, default: 0]

  Note: 'Ambang persetujuan otomatis per cabang. Satu baris untuk satu cabang.'
}

Table notifications {
  id bigint [pk, increment]
  user_id bigint [not null]
  type varchar(255) [not null]
  title varchar(255) [not null]
  message text [not null]
  data json [null]
  is_read boolean [not null, default: false]
  created_at timestamp [not null, note: 'Tabel ini hanya punya created_at, tanpa updated_at']

  indexes {
    (user_id, is_read, created_at) [name: 'notifications_user_read_created_index']
  }

  Note: 'Notifikasi dalam aplikasi. Hanya menyimpan created_at.'
}

Table notification_settings {
  id bigint [pk, increment]
  branch_id bigint [not null, unique]
  tagihan_baru_enabled boolean [not null, default: true]
  reminder_enabled boolean [not null, default: true]
  kwitansi_enabled boolean [not null, default: true]
  overdue_enabled boolean [not null, default: true]
  reminder_days_before json [null, note: 'Daftar jumlah hari sebelum jatuh tempo']
  overdue_interval_days int [not null, default: 7]

  Note: 'Preferensi pengiriman surel per cabang. Satu baris untuk satu cabang.'
}

Table notification_logs {
  id bigint [pk, increment]
  branch_id bigint [not null]
  recipient_email varchar(255) [not null]
  notification_type enum [not null, note: 'tagihan_baru, reminder, kwitansi, overdue, workflow']
  tagihan_kode varchar(255) [null]
  pengeluaran_request_id bigint [null]
  workflow_event varchar(255) [null]
  status enum [not null, note: 'sent, failed, skipped']
  reason varchar(255) [null]
  error_message text [null]
  sent_at timestamp [null]

  indexes {
    (branch_id, notification_type, status)
  }

  Note: 'Riwayat pengiriman surel, termasuk yang gagal dan yang dilewati.'
}

Table email_opt_outs {
  id bigint [pk, increment]
  email varchar(255) [not null]
  notification_type enum [not null, note: 'tagihan_baru, reminder, kwitansi, overdue, workflow, all']
  token varchar(255) [not null, unique, note: 'Token tautan berhenti berlangganan']

  indexes {
    (email, notification_type) [unique]
  }

  Note: 'Daftar penerima yang menolak jenis notifikasi tertentu.'
}

Table notification_sent_records {
  id bigint [pk, increment]
  tagihan_kode varchar(255) [not null]
  notification_type enum [not null, note: 'tagihan_baru, reminder, kwitansi, overdue']
  sent_date date [not null]

  indexes {
    (tagihan_kode, notification_type, sent_date) [unique, name: 'notif_sent_kode_type_date_unique']
  }

  Note: 'Penjaga idempoten agar satu notifikasi tidak terkirim dua kali dalam sehari.'
}

// -------------------------------------------------------------
// Relasi
// -------------------------------------------------------------

Ref: users.branch_id > branches.id [delete: cascade]
Ref: pengeluaran_requests.requester_id > users.id [delete: cascade]
Ref: pengeluaran_requests.branch_id > branches.id [delete: cascade]

Ref: approval_logs.pengeluaran_request_id > pengeluaran_requests.id [delete: cascade]
Ref: approval_logs.user_id > users.id [delete: cascade]

Ref: branch_approval_settings.branch_id - branches.id [delete: cascade]
Ref: notification_settings.branch_id - branches.id [delete: cascade]

Ref: notifications.user_id > users.id [delete: cascade]
Ref: notification_logs.branch_id > branches.id [delete: cascade]
Ref: notification_logs.pengeluaran_request_id > pengeluaran_requests.id [delete: set null]
