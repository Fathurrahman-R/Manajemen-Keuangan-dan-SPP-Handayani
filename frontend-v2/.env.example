APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# DB di-share dengan backend. Set DB_DATABASE ke database yang sama
# dengan backend (contoh: handayani). frontend-v2 tidak punya migrasi
# sendiri; semua tabel dibuat oleh backend.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=handayani
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis dipakai (bukan phpredis) — pure PHP, tidak butuh ekstensi C.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_CACHE_DB=1

# TTL cache respons API dashboard (detik). Lihat App\Services\ApiService::cachedGet().
DASHBOARD_CACHE_TTL=60

# TTL cache /rbac/user-resources & /rbac/user-groups (PermissionHelper), dipanggil tiap navigasi halaman.
RBAC_CACHE_TTL=60

# TTL cache opsi dropdown master data (kelas, kategori, jenis-tagihan) — lebih panjang
# karena bukan permukaan CRUD utama, resiko staleness rendah.
MASTER_DATA_CACHE_TTL=300

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Midtrans Payment Gateway (public-safe values only — TIDAK ada server key di sini)
#
# MIDTRANS_CLIENT_KEY harus SAMA dengan yang dipakai backend, ambil dari akun
# Midtrans Sandbox sendiri (lihat README §Setup Midtrans). Client key memang
# terekspos ke browser, tapi tetap harus milik akun kamu — kalau beda dengan
# server key di backend, Snap gagal dibuka.
HANDAYANI_MIDTRANS_ENABLED=true
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxx
MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
HANDAYANI_MIDTRANS_FEE_FLAT=4000

# Identitas halaman publik (landing page) — semuanya OPSIONAL, sudah punya default
# di config/handayani-public.php. Uncomment hanya yang mau di-override.
#HANDAYANI_PUBLIC_NAME="Lembaga Pendidikan Anak Handayani"
#HANDAYANI_PUBLIC_SHORT_NAME=Handayani
#HANDAYANI_PUBLIC_TAGLINE="Mandiri, Intelektual, Smart, Hafiz Qur'an"
#HANDAYANI_PUBLIC_ADDRESS="Jl. Selat Panjang No.357, Siantan Hulu, Kec. Pontianak Utara, Kota Pontianak, Kalimantan Barat 78243"
#HANDAYANI_PUBLIC_PHONE="(021) 1234-5678"
#HANDAYANI_PUBLIC_EMAIL=info@handayani.sch.id
#HANDAYANI_PUBLIC_WHATSAPP=6281234567890
#HANDAYANI_PUBLIC_SPP_PORTAL_URL=/login
#HANDAYANI_PUBLIC_LOGO=images/logo.jpg
#HANDAYANI_PUBLIC_COLOR_PRIMARY=#1B4FBF
#HANDAYANI_PUBLIC_COLOR_ACCENT=#0D8A6E

# Konten section (visi, misi, ekstrakurikuler, fasilitas, nav_links, jenjang, dst.)
# TIDAK lewat env — edit langsung di config/handayani-public.php. Lihat README
# §Konten halaman publik: beberapa key wajib array, bukan string.
